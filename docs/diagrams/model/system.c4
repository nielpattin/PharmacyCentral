model {
  pharmacyCentral = system "Pharmacy Central" {
    summary "Express 5 microservices monorepo for the customer and staff pharmacy workflows."

    web = container "Web tier" {
      summary "Two independent Vite single page applications, built on the shared @pharmacy/ui package."

      customerWeb = webapp "customer-web" {
        technology "React + Vite"
        summary "Storefront: search, cart, checkout, prescription photo, invoice and shopping assistant."
        metadata { package "@pharmacy/customer-web" }
      }

      staffWeb = webapp "staff-web" {
        technology "React + Vite"
        summary "Internal portal: dashboards, finance, audit, reports, master data, stock, procurement and imports."
        metadata { package "@pharmacy/staff-web" }
      }
    }

    security = container "Edge and access control" {
      summary "The components in front of the services that decide who the caller is."

      sessionAuthorizer = function "Session and CSRF authorizer" {
        technology "AWS Lambda (Node.js 22)"
        summary "Lambda authorizer: session, role, site scope, CSRF, and the signed identity context."
      }
    }

    services = container "Application services" {
      summary "Eight business services. They never import each other, they talk over HTTP and over events."

      searchService = service "search-service" {
        technology "Go + Typesense"
        summary "The read path of GET /api/products only. It answers from the Typesense index and falls back to catalog-service when the index is down. It never reads PostgreSQL."
        metadata { port "3009"; package "@pharmacy/search-service" }
      }
    }

    data = container "Data tier" {
      summary "The infrastructure owned by the platform, not by a single service."

      postgres = database "PostgreSQL 18 + PostGIS" {
        summary "One database per service. Each service owns its schema, its migrations and its write model."

        identityDb = database "identity_service" {
          summary "Accounts, sessions, verification tokens, employee roles and site access."
        }
        catalogDb = database "catalog_service" {
          summary "Sites, storage locations, products, units, suppliers, prices, synonyms, AI credentials."
        }
        inventoryDb = database "inventory_service" {
          summary "Batches, balances, movements, reservations, transfers, stocktakes, purchase orders, receipts."
        }
        salesDb = database "sales_service" {
          summary "Carts, orders, delivery snapshots, prescriptions, consultations, counter transactions."
        }
        paymentDb = database "payment_service" {
          summary "Invoices, attempts, transactions, refunds, QR instructions, reconciliation."
        }
        operationsDb = database "operations_query_service" {
          summary "Dashboard counters, finance entries, audit events, report rows."
        }
        chatbotDb = database "chatbot_service" {
          summary "Chat sessions, chat messages, AI credentials."
        }
      }

      rabbitmq = broker "RabbitMQ 4" {
        summary "The domain event bus. The topic exchange pharmacy.events carries the versioned events."
      }

      redis = cache "Redis 8" {
        summary "Non authoritative cache: the delivery route cache and the prescription intake rate limiter."
      }

      typesense = searchIndex "Typesense 30" {
        summary "Derived product search index, rebuilt from PostgreSQL by the catalogue."
      }

      embedder = searchIndex "Embedder (TEI)" {
        summary "Optional self-hosted text embeddings for the product search: HuggingFace text-embeddings-inference running multilingual-e5-small on CPU. Started with the compose profile embedder. An alternative to Gemini that needs no quota."
      }

      seaweedfs = objectStorage "SeaweedFS (S3)" {
        summary "Object storage of the product images, S3 compatible."
      }

      mailpit = mail "Mailpit" {
        summary "Local SMTP sink of the verification and password reset emails."
      }

      telemetry = observability "OpenTelemetry Collector" {
        #obs
        summary "Receives the OTLP traces, metrics and logs of every service and fans them out to the backends. Also scrapes the queue depth of RabbitMQ from its management API."
      }

      tempo = observability "Tempo" {
        #obs
        summary "Trace store. Keeps the traces for 72 hours."
      }

      prometheus = observability "Prometheus" {
        #obs
        summary "Metrics store, fed by the OTLP receiver of the collector."
      }

      loki = observability "Loki" {
        #obs
        summary "Log store, fed by the OTLP ingest of the collector. Keeps the logs for 72 hours."
      }

      grafana = observability "Grafana" {
        #obs
        summary "Dashboards and Explore over Tempo, Prometheus and Loki. The local UI of the telemetry."
      }

      k6 = observability "k6" {
        #obs
        summary "Load generator, started on demand with pnpm run load. It drives the customer and staff journeys through the gateway and pushes its results to Prometheus. The chaos runner reuses it as its background load."
      }
    }
  }
}
