model {
  extend pharmacyCentral.services {
    identityService = service "identity-service" {
      technology "Express 5 + Drizzle"
      summary "Owns the accounts, the access token signing, the Google sign-in and the employee access data."
      metadata { port "3001"; package "@pharmacy/identity-service" }

      accounts = component "Accounts and registration" {
        summary "Registration, email verification, password reset and the Argon2id hashing."
      }

      tokens = component "Access tokens" {
        summary "Signs the one-day ES256 access token, the only credential the browser keeps, and publishes the JWKS. It keeps no per-sign-in state."
      }

      admin = component "Employee administration" {
        summary "Employee accounts, role groups, the sites each employee may act on, deactivation and the forced password change."
      }

      customers = component "Customer directory" {
        summary "Customer profiles and the internal lookup that sales-service uses for a buyer."
      }
    }
  }
}
