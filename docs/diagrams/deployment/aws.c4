deployment {
  aws = environment "AWS, ECS Fargate" {
    summary "The topology of deploy/aws in us-east-1, sized as the low cost demo of docs/design/0006: one task per service, one database instance, one NAT gateway."

    edge = zone "Public edge" {
      webAlb = managed "Public ALB, both web apps" {
        summary "HTTPS with one ACM certificate; port 80 redirects. Host rules for shop. and staff. keep the cookies of customer-web and staff-web apart."
      }

      apiGateway = managed "API Gateway, HTTP API" {
        summary "The public surface of /api. CORS, throttling, and the raw bytes of the SePay webhook."
      }

      authorizer = workload "Lambda, session and CSRF authorizer" {
        instanceOf pharmacyCentral.security.sessionAuthorizer
      }

      csrfLambda = managed "Lambda, CSRF token" {
        summary "Answers GET /api/auth/csrf and issues the pharmacy_csrf cookie."
      }

      vpcLink = managed "VPC Link" {
        summary "The private path from the API Gateway into the VPC."
      }

      alb = managed "Internal Application Load Balancer" {
        summary "Routes the paths to the ECS services, the same routing map as the local gateway. Unknown paths answer a JSON 404."
      }
    }

    compute = zone "Private subnets" {
      ecs = cluster "ECS Fargate cluster" {
        summary "One long running task per service, the web apps and Typesense, plus one shot migration and ops tasks that never run on start. The collector and the embedder are optional and off by default."

        customerWebTask = workload "customer-web :8080" {
          summary "nginx serving the Vite build. It proxies /api to the API Gateway."
          instanceOf pharmacyCentral.web.customerWeb
        }
        staffWebTask = workload "staff-web :8080" {
          summary "nginx serving the Vite build. It proxies /api to the API Gateway."
          instanceOf pharmacyCentral.web.staffWeb
        }

        identityTask = workload "identity-service :3001" {
          instanceOf pharmacyCentral.services.identityService
        }
        catalogTask = workload "catalog-service :3002" {
          instanceOf pharmacyCentral.services.catalogService
        }
        inventoryTask = workload "inventory-service :3004" {
          instanceOf pharmacyCentral.services.inventoryService
        }
        salesTask = workload "sales-service :3005" {
          instanceOf pharmacyCentral.services.salesService
        }
        paymentTask = workload "payment-service :3006" {
          instanceOf pharmacyCentral.services.paymentService
        }
        operationsTask = workload "operations-query-service :3007" {
          instanceOf pharmacyCentral.services.operationsService
        }
        chatbotTask = workload "chatbot-service :3008" {
          instanceOf pharmacyCentral.services.chatbotService
        }
        opsConsoleTask = workload "ops-console-service :3010" {
          summary "Platform Admin only. The edge Lambda policy and the service both check the role."
          instanceOf pharmacyCentral.services.opsConsoleService
        }
        otelCollectorTask = workload "otel-collector :4318" {
          summary "Optional (otel_collector_enabled, off by default). One ADOT task. The services push OTLP/HTTP to it through Cloud Map; it forwards metrics, traces and logs to AWS."
          instanceOf pharmacyCentral.data.telemetry
        }
        searchTask = workload "search-service :3009" {
          summary "Product list only. Behind the internal ALB, with no Cloud Map name of its own."
          instanceOf pharmacyCentral.services.searchService
        }
        embedderTask = workload "embedder :80" {
          summary "Optional (embedder_enabled, off by default). Self-hosted text embeddings. The model is baked into the image, one task, no autoscaling, internal only."
          instanceOf pharmacyCentral.data.embedder
        }
        typesenseTask = workload "typesense :8108" {
          summary "One task named typesense in Cloud Map, on ephemeral disk. The index is a derived copy that catalog-service rebuilds from PostgreSQL."
          instanceOf pharmacyCentral.data.typesense
        }
      }
    }

    managedData = zone "Managed data services" {
      summary "Provisioned by deploy/aws, single instance each, in the private subnets with no public address. Connection strings live in SSM Parameter Store."

      rds = workload "RDS PostgreSQL 18, db.t4g.micro" {
        instanceOf pharmacyCentral.data.postgres
      }
      redisManaged = workload "ElastiCache Redis 7.1, cache.t4g.micro" {
        instanceOf pharmacyCentral.data.redis
      }
      rabbitManaged = workload "RabbitMQ 4, one Fargate task" {
        instanceOf pharmacyCentral.data.rabbitmq
      }
      mediaBucket = managed "S3 media bucket" {
        summary "Product images. Objects under product-images/ are public read, because the catalog stores their plain URLs. catalog-service writes with a scoped IAM user key."
        instanceOf pharmacyCentral.data.seaweedfs
      }
      secrets = managed "SSM Parameter Store" {
        summary "SecureString parameters: DATABASE_URL (one per service, each with its own database role), RABBITMQ_URL, REDIS_URL, TYPESENSE_*. Only the two internal secrets the authorizer Lambda reads are in Secrets Manager."
      }
      prometheusManaged = managed "Amazon Managed Service for Prometheus" {
        summary "Only with the collector. Receives the metrics by remote write. Queries need SigV4, so ops-console-service cannot read it directly yet."
      }
      xray = managed "AWS X-Ray" {
        summary "Receives the traces."
      }
      cloudwatch = managed "CloudWatch Logs" {
        summary "Receives the logs of the tasks, of the Lambdas and of the API Gateway."
      }
    }

    external = zone "Third parties" {
      googleNode = managed "Google OIDC"
      geminiNode = managed "Google Gemini API"
      typesafeNode = managed "TypeSafe Jev API"
      openaiCompatibleNode = managed "OpenAI-compatible API"
      vietmapNode = managed "VietMap API"
      openRouteNode = managed "OpenRouteService"
      sepayNode = managed "SePay"
    }
  }
}
