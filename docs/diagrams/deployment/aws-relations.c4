deployment {
  aws.edge.webTier -> aws.edge.apiGateway "HTTPS /api" {
    technology "HTTPS"
  }

  aws.edge.apiGateway -> aws.edge.authorizer "Session, role, site scope and CSRF" {
    technology "Lambda invoke"
  }
  aws.edge.apiGateway -> aws.edge.csrfLambda "GET /api/auth/csrf" {
    technology "Lambda invoke"
  }
  aws.edge.apiGateway -> aws.edge.vpcLink "HTTP /api" {
    technology "HTTP"
  }
  aws.edge.vpcLink -> aws.edge.alb "HTTP on port 80" {
    technology "HTTP"
  }

  aws.edge.alb -> aws.compute.ecs.identityTask "route /api/auth, /api/admin, /api/customers" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.catalogTask "route /api/sites, /api/products/*, /api/pricing, /api/stores, /api/availability" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.searchTask "route GET /api/products, the list only" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.inventoryTask "route /api/procurement, /api/inventory" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.salesTask "route /api/carts, /api/orders, /api/delivery, /api/prescriptions" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.paymentTask "route /api/payments" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.operationsTask "route /api/dashboard, /api/finance, /api/reports" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.chatbotTask "route /api/chatbot" {
    technology "HTTP"
  }
  aws.edge.alb -> aws.compute.ecs.opsConsoleTask "route /api/system" {
    technology "HTTP"
  }
  aws.compute.ecs.opsConsoleTask -> aws.managedData.rabbitManaged "Queues, management API" {
    technology "HTTPS"
  }
  aws.compute.ecs.opsConsoleTask -> aws.managedData.typesenseManaged "Collections" {
    technology "HTTP"
  }
  aws.compute.ecs.otelCollectorTask -> aws.managedData.prometheusManaged "Metrics, remote write with SigV4" {
    technology "HTTPS"
  }
  aws.compute.ecs.otelCollectorTask -> aws.managedData.xray "Traces" {
    technology "HTTPS"
  }
  aws.compute.ecs.otelCollectorTask -> aws.managedData.cloudwatch "Logs" {
    technology "HTTPS"
  }

  aws.compute.ecs.identityTask -> aws.external.googleNode "Google sign-in" {
    technology "HTTPS"
  }
  aws.compute.ecs.catalogTask -> aws.external.geminiNode "Product embeddings" {
    technology "HTTPS"
  }
  aws.compute.ecs.catalogTask -> aws.compute.ecs.embedderTask "Product embeddings, OpenAI-compatible, only catalog-service and search-service may call it" {
    technology "HTTP, POST /v1/embeddings"
  }
  aws.compute.ecs.catalogTask -> aws.managedData.typesenseManaged "Writes the product index catalog_products_v3" {
    technology "HTTP"
  }
  aws.compute.ecs.searchTask -> aws.managedData.typesenseManaged "Product search, payload field only" {
    technology "HTTP"
  }
  aws.compute.ecs.searchTask -> aws.compute.ecs.catalogTask "Fallback: the same request, when Typesense is down" {
    technology "HTTP"
  }
  aws.compute.ecs.searchTask -> aws.compute.ecs.embedderTask "Query embedding, queries of three words or more, POST /v1/embeddings" {
    technology "HTTP"
  }
  aws.compute.ecs.salesTask -> aws.external.geminiNode "Prescription vision call" {
    technology "HTTPS"
  }
  aws.compute.ecs.chatbotTask -> aws.external.geminiNode "Chat model with tool calling" {
    technology "HTTPS"
  }
  aws.compute.ecs.chatbotTask -> aws.external.openaiCompatibleNode "Chat model with tool calling, optional provider" {
    technology "HTTPS"
  }
  aws.compute.ecs.chatbotTask -> aws.external.typesafeNode "Jev gate" {
    technology "HTTPS"
  }
  aws.compute.ecs.salesTask -> aws.external.vietmapNode "Geocoding" {
    technology "HTTPS"
  }
  aws.compute.ecs.salesTask -> aws.external.openRouteNode "Driving route" {
    technology "HTTPS"
  }
  aws.external.sepayNode -> aws.edge.apiGateway "Payment webhook, raw bytes preserved" {
    technology "HTTPS"
  }
}
