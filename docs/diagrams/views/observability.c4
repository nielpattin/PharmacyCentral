views {
  view observability {
    title "Telemetry"
    description """
      The nine services export their traces, metrics and logs over OTLP to the OpenTelemetry Collector,
      which fans them out to Tempo, Prometheus and Loki. Grafana reads the three backends. k6 pushes its load test results to Prometheus.
    """
    include pharmacyCentral.services.*
    include pharmacyCentral.data.telemetry
    include pharmacyCentral.data.tempo
    include pharmacyCentral.data.prometheus
    include pharmacyCentral.data.loki
    include pharmacyCentral.data.grafana
    include pharmacyCentral.data.k6
    exclude * -> * where target.kind is service
  }
}
