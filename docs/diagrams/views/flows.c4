views {
  dynamic view checkoutFlow {
    variant sequence
    title "Checkout, from the cart to the paid invoice"
    description """
      The price, the distance and the fee of the order are recalculated by sales-service, and the stock of
      the store is held for the order before it exists for the shopper: the hold is all or nothing, taken
      from the earliest expiry first, and an order the store cannot cover is cancelled and answered 409.

      The browser then asks payment-service for the invoice. A shopper never sets a price: payment-service
      reads the order from sales-service and prices the invoice from the lines sales snapshot.

      Paying confirms the order through payment.invoice.paid.v1. The goods leave the shelf only when staff
      hand the order over (Delivering or Completed). A cancelled order, an order nobody paid for within 30
      minutes (24 hours for cash on delivery), and a refunded order that was not handed over give the hold back.
    """

    customer -> pharmacyCentral.web.customerWeb "adds a product to the cart"
    pharmacyCentral.web.customerWeb -> pharmacyCentral.services.salesService "POST /api/carts, POST /api/orders"
    pharmacyCentral.services.salesService -> pharmacyCentral.services.catalogService "GET /api/products, GET /api/pricing/active"
    pharmacyCentral.services.catalogService -> pharmacyCentral.services.salesService "the product and the published price"
    pharmacyCentral.services.salesService -> pharmacyCentral.services.inventoryService "POST /api/inventory/reservations, the order id is the reservation id"
    pharmacyCentral.services.inventoryService -> pharmacyCentral.services.salesService "held, or 409 insufficient_stock"
    pharmacyCentral.services.salesService -> pharmacyCentral.web.customerWeb "the Pending order, with the recalculated lines and fee"
    pharmacyCentral.web.customerWeb -> pharmacyCentral.services.paymentService "POST /api/payments/invoices, the order id"
    pharmacyCentral.services.paymentService -> pharmacyCentral.services.salesService "GET /api/orders, as the shopper"
    pharmacyCentral.services.salesService -> pharmacyCentral.services.paymentService "the order and its snapshot prices"
    pharmacyCentral.services.paymentService -> pharmacyCentral.web.customerWeb "the SePay QR instruction"
    sepayGateway -> pharmacyCentral.services.paymentService "POST /api/payments/sepay/webhook, HMAC over the raw bytes"
    pharmacyCentral.services.paymentService -> pharmacyCentral.data.rabbitmq "publish payment.invoice.paid.v1"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.salesService "payment.invoice.paid.v1"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.operationsService "payment.invoice.paid.v1"
    pharmacyCentral.services.salesService -> pharmacyCentral.web.customerWeb "the order is Confirmed"
  }

  dynamic view prescriptionIntake {
    variant sequence
    title "Prescription intake, from the photo to the consultation"
    description """
      A line that the chosen store cannot fill becomes a consultation for a pharmacist. It is its own
      aggregate, because a question names no product, no site and no storage location.
    """

    customer -> pharmacyCentral.web.customerWeb "uploads the photo of a printed prescription"
    pharmacyCentral.web.customerWeb -> pharmacyCentral.services.salesService "POST /api/prescriptions/intake/image"
    pharmacyCentral.services.salesService -> geminiApi "one vision call, schema constrained JSON"
    geminiApi -> pharmacyCentral.services.salesService "the read lines"
    pharmacyCentral.services.salesService -> pharmacyCentral.services.catalogService "POST /api/products/match"
    pharmacyCentral.services.catalogService -> pharmacyCentral.services.salesService "the closest products of every line"
    pharmacyCentral.services.salesService -> pharmacyCentral.web.customerWeb "the suggestions, or the request to find the medicine"
    customer -> pharmacyCentral.web.customerWeb "asks a pharmacist to find it"
    pharmacyCentral.web.customerWeb -> pharmacyCentral.services.salesService "POST /api/prescriptions/consultations, with an Idempotency-Key"
    pharmacist -> pharmacyCentral.web.staffWeb "answers the consultation"
    pharmacyCentral.web.staffWeb -> pharmacyCentral.services.salesService "POST the answer"
    pharmacyCentral.services.salesService -> pharmacyCentral.data.rabbitmq "publish sales.prescription-consultation.answered.v1"
  }

  dynamic view chatbotToolCalling {
    variant sequence
    title "Shopping assistant, Jev gate and tool calling"
    description """
      Jev classifies the question first, in one request, and the code decides. A greeting, an
      out of scope question, an emergency or an injection gets a fixed reply and costs no Gemini call.
      Every other question goes on to the chat model. Jev gets a timeout and two retries with backoff.
      When it still fails the customer is told that the assistant is down, nothing is saved, and the
      chat model is not called. Without Jev settings the gate is off and every question goes on.

      Nothing of the catalogue goes into the prompt before the model runs. The model decides when to
      search and when to read a product, and a question costs at most three model calls.
    """

    customer -> pharmacyCentral.web.customerWeb "asks about a symptom or a medicine"
    pharmacyCentral.web.customerWeb -> pharmacyCentral.services.chatbotService "POST /api/chatbot"
    pharmacyCentral.services.chatbotService -> typesafeApi "the question and the last exchange, with a Choice intent and the Noul emergency and injection"
    typesafeApi -> pharmacyCentral.services.chatbotService "the intent, the probabilities and the confidence"
    alt {
      when 'greeting, out of scope, emergency or injection' {
        pharmacyCentral.services.chatbotService -> pharmacyCentral.web.customerWeb "blocked: a fixed reply, no model call"
      }
      when 'Jev fails after the retries' {
        pharmacyCentral.services.chatbotService -> pharmacyCentral.web.customerWeb "503: the assistant is having trouble, try again in a few minutes"
      }
      else 'product or order help' {
        pharmacyCentral.services.chatbotService -> geminiApi "allowed: the question, the history and the tool list"
        geminiApi -> pharmacyCentral.services.chatbotService "a request for search_products"
        pharmacyCentral.services.chatbotService -> pharmacyCentral.services.catalogService "GET /api/products"
        pharmacyCentral.services.catalogService -> pharmacyCentral.services.chatbotService "the matching products and the active price"
        pharmacyCentral.services.chatbotService -> geminiApi "the question, the tool result and the history"
        geminiApi -> pharmacyCentral.services.chatbotService "the final answer, tools disabled"
        pharmacyCentral.services.chatbotService -> pharmacyCentral.web.customerWeb "the answer and the product cards"
      }
    }
  }

  dynamic view staffDataImport {
    variant sequence
    title "Import of the master data and of the opening balances"
    description """
      The business master data is imported through the API, never served from a file by the web app.
      The images are uploaded to the object storage first, because the import file carries their
      content hash keys.
    """

    platformAdmin -> pharmacyCentral.web.staffWeb "imports the sample CSV files"
    pharmacyCentral.web.staffWeb -> pharmacyCentral.services.catalogService "POST /api/products/imports"
    pharmacyCentral.services.catalogService -> pharmacyCentral.data.postgres.catalogDb "the products, the prices and the suppliers"
    pharmacyCentral.web.staffWeb -> pharmacyCentral.services.inventoryService "POST /api/inventory/imports/opening-balances"
    pharmacyCentral.services.inventoryService -> pharmacyCentral.data.postgres.inventoryDb "the batches and the balances"
    pharmacyCentral.services.inventoryService -> pharmacyCentral.data.rabbitmq "relay inventory.availability.changed.v1 from the outbox"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.catalogService "the availability of the imported stock"
  }

  dynamic view operationsReadModel {
    variant sequence
    title "The read model behind the staff dashboards"
    description """
      The dashboards are fed by the events, but the live figures are asked from the service that owns
      them, with the scope of the reader forwarded as x-actor-site-ids.
    """

    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.operationsService "an event of the exchange pharmacy.events"
    pharmacyCentral.services.operationsService -> pharmacyCentral.data.postgres.operationsDb "apply the event, idempotent by projection key"
    branchManager -> pharmacyCentral.web.staffWeb "opens the dashboard of the site"
    pharmacyCentral.web.staffWeb -> pharmacyCentral.services.operationsService "GET /api/dashboard/summary"
    pharmacyCentral.services.operationsService -> pharmacyCentral.services.inventoryService "GET the balances of the reader sites"
    pharmacyCentral.services.inventoryService -> pharmacyCentral.services.operationsService "the balances"
    pharmacyCentral.services.operationsService -> pharmacyCentral.web.staffWeb "the dashboard"
  }

  dynamic view outboxDelivery {
    variant sequence
    title "A stock change reaches the storefront, through the outbox"
    description """
      The stock change and its event commit in one transaction, so a crash or a broker outage after
      the commit only delays the event: the row stays unpublished and the next tick sends it. The row
      is marked published only after the broker confirmed the message, so the delivery is at least
      once and the consumer has to tolerate a repeated event. A message the consumer keeps failing is
      retried five times, then parked on the dead-letter queue catalog.availability.v2.dead.
      The row also stores the trace context, so the trace continues across the broker.
    """

    pharmacyCentral.services.inventoryService.stock -> pharmacyCentral.data.postgres.inventoryDb "one transaction: the balance, the ledger entry and the availability outbox row"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.postgres.inventoryDb "every second: read the unpublished rows, oldest first"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.rabbitmq "publish inventory.availability.changed.v1, persistent, wait for the broker confirm"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.postgres.inventoryDb "mark the row published"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.catalogService "deliver to the durable queue catalog.availability.v2"
    pharmacyCentral.services.catalogService -> pharmacyCentral.data.rabbitmq "ack after the in stock flag is applied"
  }

  dynamic view traceThroughOutbox {
    variant sequence
    title "One trace follows an event from the request to its consumers"
    description """
      The example is the import of the opening balances. The request span, the stock change and the outbox
      row commit in one transaction, and the row keeps the traceparent of the request. The relay reads the
      row every second and publishes it inside that stored context, so the publish span and the process span
      of each consumer join the same trace. Every service exports its spans to the collector, and Grafana
      reads the trace through Tempo.
    """

    platformAdmin -> pharmacyCentral.web.staffWeb "imports the opening balances"
    pharmacyCentral.web.staffWeb -> pharmacyCentral.services.inventoryService "POST /api/inventory/imports/opening-balances, the HTTP server span"
    pharmacyCentral.services.inventoryService.stock -> pharmacyCentral.data.postgres.inventoryDb "one transaction: the balances, the ledger entry and the outbox row with its traceparent"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.postgres.inventoryDb "every second: read the unpublished rows and their traceparent"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.rabbitmq "publish inventory.availability.changed.v1 under the stored context, traceparent header, wait for the broker confirm"
    pharmacyCentral.services.inventoryService.outbox -> pharmacyCentral.data.postgres.inventoryDb "mark the row published"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.catalogService "deliver to catalog.availability.v2, the process span joins the trace"
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.operationsService "deliver to operations-query.events.v2, the process span joins the trace"
    pharmacyCentral.services.inventoryService -> pharmacyCentral.data.telemetry "OTLP spans: the request, the stock change, the publish"
    pharmacyCentral.services.catalogService -> pharmacyCentral.data.telemetry "OTLP spans: the process span"
    pharmacyCentral.services.operationsService -> pharmacyCentral.data.telemetry "OTLP spans: the process span"
    pharmacyCentral.data.telemetry -> pharmacyCentral.data.tempo "OTLP traces"
    pharmacyCentral.data.grafana -> pharmacyCentral.data.tempo "query the trace"
  }

  dynamic view asyncReliability {
    variant sequence
    title "What the messaging layer does when something fails"
    description """
      The example is payment.invoice.paid.v1 on its way to sales-service. Inventory, sales and payment
      relay the same way, and catalog and operations consume the same way.

      Two relays of one database never publish together: a Postgres advisory lock lets one of them
      read the unpublished rows, which keeps the order and prevents a duplicate. A consumer rebuilds
      its connection five seconds after it drops, so a broker restart does not leave a silent service.

      Nothing raises an alert yet. What to look at by hand: the number of outbox rows with a null
      published_at is the lag of a relay, and a message on a queue named *.dead needs a person.
    """

    pharmacyCentral.services.paymentService.outbox -> pharmacyCentral.data.rabbitmq "publish payment.invoice.paid.v1, persistent, wait for the broker confirm"
    alt {
      when 'the broker is down, or the connection drops before the confirm' {
        pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.paymentService.outbox "no confirm: the row stays unpublished and the next tick rebuilds the connection and sends it again"
      }
      else 'the broker confirms' {
        pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.paymentService.outbox "confirm: only now is the row marked published"
      }
    }
    pharmacyCentral.data.rabbitmq -> pharmacyCentral.services.salesService.paymentEvents "deliver from the quorum queue sales.payment-events.v2, one message at a time"
    alt {
      when 'the payload is not JSON' {
        pharmacyCentral.services.salesService.paymentEvents -> pharmacyCentral.data.rabbitmq "reject: parked at once on sales.payment-events.v2.dead"
      }
      when 'the handler fails' {
        pharmacyCentral.services.salesService.paymentEvents -> pharmacyCentral.data.rabbitmq "requeue after a growing wait; the fifth failure is rejected and parked on sales.payment-events.v2.dead"
      }
      else 'the order is updated' {
        pharmacyCentral.services.salesService.paymentEvents -> pharmacyCentral.data.rabbitmq "ack"
      }
    }
  }
}
