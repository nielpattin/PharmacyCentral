views {
  deployment view localCompose {
    title "Local topology, Docker Compose"
    description """
      The same images and the same path routing map as production, behind the Nginx gateway of the
      Compose stack. The telemetry edges are left out of this diagram, the observability view shows them.
    """
    include local.**
    exclude * -> * where target.tag is #obs
    exclude * -> * where source.kind is webapp
  }

  deployment view awsEcs {
    title "Production topology, AWS ECS Fargate"
    description """
      The browser reaches a web app through its own public ALB. The web container proxies /api to the
      API Gateway, which asks the Lambda authorizer, then goes through the VPC Link to the internal ALB
      and on to the ECS Fargate tasks of the services.
    """
    include aws.**
  }
}
