{
  "name": "@pharmacy/inventory-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "node --experimental-transform-types --watch --env-file=../../.env src/main.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware src",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-amqplib": "catalog:",
    "@opentelemetry/instrumentation-express": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@pharmacy/auth": "workspace:*",
    "amqplib": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:application",
      "scope:inventory-service"
    ],
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/inventory-service/dist/package.json",
          "{workspaceRoot}/apps/inventory-service/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/inventory-service/dist/pnpm-workspace.yaml"
        ],
        "options": {
          "buildTarget": "build",
          "outputPath": "apps/inventory-service/dist"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:copy-workspace-modules",
        "outputs": [
          "{workspaceRoot}/apps/inventory-service/dist/workspace_modules"
        ],
        "options": {
          "buildTarget": "build",
          "outputPath": "apps/inventory-service/dist"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      }
    }
  }
}
