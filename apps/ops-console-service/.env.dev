# Loaded by Nx for the `dev` target before the root .env, so these win over its shared PORT.
# Values come from the root .env; Compose sets its own for the container.
PORT=${OPS_CONSOLE_PORT}
SEARCH_SERVICE_URL=http://localhost:${SEARCH_PORT}
PAYMENT_SERVICE_URL=http://localhost:${PAYMENT_PORT}
OPERATIONS_QUERY_SERVICE_URL=http://localhost:${OPERATIONS_QUERY_PORT}
CHATBOT_SERVICE_URL=http://localhost:${CHATBOT_PORT}
PROMETHEUS_URL=http://localhost:${PROMETHEUS_PORT}
RABBITMQ_MANAGEMENT_URL=http://localhost:${RABBITMQ_MANAGEMENT_PORT}
RABBITMQ_MANAGEMENT_USER=${RABBITMQ_USER}
RABBITMQ_MANAGEMENT_PASSWORD=${RABBITMQ_PASSWORD}
