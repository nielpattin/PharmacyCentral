FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS build

WORKDIR /workspace

RUN npm install --global pnpm@12.3.4
# `pnpm fetch` needs only the lockfile and workspace settings, so this layer is identical for every service and is
# rebuilt only when the lockfile changes. Its store stays in the layer (no cache mount), so `install --offline` below
# works even after the BuildKit cache is pruned. The ARGs come after it so their values do not change its cache key.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

ARG APP_NAME
ARG APP_DIR
COPY package.json tsconfig.base.json tsconfig.json nx.json ./
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools
RUN pnpm install --offline --frozen-lockfile
RUN pnpm exec nx run "${APP_NAME}:build"
RUN pnpm deploy --legacy --filter "${APP_NAME}" --prod /out
RUN mkdir -p "/out/dist" && cp -R "/workspace/${APP_DIR}/dist/." "/out/dist/"
RUN if [ -d "/workspace/${APP_DIR}/drizzle/migrations" ]; then mkdir -p /out/drizzle/migrations && cp -R "/workspace/${APP_DIR}/drizzle/migrations/." /out/drizzle/migrations/; fi

# The runtime is Alpine with only the Node binary: the official Node image adds npm, yarn and a Debian base the
# services never use. The binary comes from the same Node release as the build stage; stripping drops its debug symbols.
FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS node
RUN apk add --no-cache binutils \
  && cp /usr/local/bin/node /node \
  && strip --strip-unneeded /node

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS runtime
ARG BUILD_VERSION
WORKDIR /app
ENV NODE_ENV=production
# service.version in target_info comes from the build version (OTel reads OTEL_RESOURCE_ATTRIBUTES).
ENV OTEL_RESOURCE_ATTRIBUTES=service.version=${BUILD_VERSION}
RUN apk add --no-cache libstdc++ \
  && adduser -S -D -H -u 1000 node
COPY --from=node /node /usr/local/bin/node
USER node
COPY --from=build --chown=node:node /out ./
EXPOSE 3000
CMD ["sh", "-c", "if [ -f dist/migrate.js ]; then node dist/migrate.js; fi && node dist/main.js"]
