FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS build

ARG APP_NAME
ARG APP_DIR
WORKDIR /workspace

RUN npm install --global pnpm@12.3.4
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json nx.json ./
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools
RUN --mount=type=cache,id=pharmacy-central-pnpm-store,target=/root/.local/share/pnpm/store/v11 pnpm install --frozen-lockfile
RUN pnpm exec nx run "${APP_NAME}:build"

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runtime
ARG APP_NAME
ARG APP_DIR
COPY --from=build "/workspace/${APP_DIR}/dist" /usr/share/nginx/html
COPY apps/nginx-entrypoint.sh /docker-entrypoint.d/40-api-proxy.sh
RUN chmod +x /docker-entrypoint.d/40-api-proxy.sh
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
