{
  "name": "@pharmacy/identity-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "node --experimental-transform-types --watch --env-file=../../.env src/main.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware src",
    "seed": "node --env-file=../../.env seed.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "nodemailer": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:application",
      "scope:identity-service"
    ]
  }
}
