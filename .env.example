JIRA_EMAIL=your@mail
JIRA_API_TOKEN=replace_with_atlassian_api_token
GWS_SPREADSHEET_ID=16viCFvHYm3l....
JIRA_PROJECT_KEY=PCR
JIRA_BASE_URL=https://org_name.atlassian.net
# Google Sheets auth via credentials.json in repo root (or set GWS_CREDENTIALS_PATH)
# Sheet names are optional, defaults: helper="Jira Sync", visible="Timeline"
GWS_HELPER_SHEET_NAME=Jira Sync
GWS_VISIBLE_SHEET_NAME=Timeline
GWS_VISIBLE_LIMIT=150
# GWS_CREDENTIALS_PATH=C:\path\to\credentials.json


# PharmacyCentral local seeding toggles.
# Set business/demo users to false when validating a fresh database from only bootstrap admin.
PHARMACY_SEED_ADMIN_USER=true
PHARMACY_SEED_DEMO_USERS=true
PHARMACY_SEED_BUSINESS_DATA=true


# PharmacyCentral local SePay/VietQR test-mode settings.
# Put real test-mode values only in .env, never in this example file.
PHARMACY_PAYMENT_SEPAY_ENABLED=false
PHARMACY_PAYMENT_SEPAY_BANK=MB
PHARMACY_PAYMENT_SEPAY_ACCOUNT_NUMBER=replace_with_test_account_number
PHARMACY_PAYMENT_SEPAY_PREFIX=PC
PHARMACY_PAYMENT_SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
PHARMACY_PAYMENT_SEPAY_WEBHOOK_SECRET=replace_with_random_secret