# Node.js service runtime and networking
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:8080

# Service ports (for running individual services locally on host)
IDENTITY_PORT=3001
CATALOG_PORT=3002
SEARCH_PORT=3009
INVENTORY_PORT=3004
SALES_PORT=3005
CHATBOT_PORT=3008
OPS_CONSOLE_PORT=3010
PAYMENT_PORT=3006
OPERATIONS_QUERY_PORT=3007
GATEWAY_PORT=8080

# Load and chaos runs with k6 (`pnpm run load`). Point it at the gateway the k6 container can reach:
# http://host.docker.internal:8080 against `pnpm dev`, http://gateway:8080 against `stack:up`.
LOAD_TARGET_URL=http://host.docker.internal:8080

# Infrastructure host ports
POSTGRES_PORT=5432
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
CUSTOMER_WEB_PORT=5301
STAFF_WEB_PORT=5302
DIAGRAMS_PORT=5303
SEAWEEDFS_S3_PORT=9000
TYPESENSE_PORT=8108
EMBEDDER_PORT=8109
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090
# The address a Platform Admin opens Grafana at; the System page in staff-web links to it.
GRAFANA_PUBLIC_URL=http://localhost:3030

# OpenTelemetry. Every service exports traces and metrics here over OTLP/HTTP. Compose overrides it for the containers.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Build version stamped into every backend image as service.version (Prometheus label service_version on target_info).
# Release builds set it to the commit SHA; local builds use local.
BUILD_VERSION=local

# Grafana (dashboards over Tempo traces, Prometheus metrics and Loki logs). Admin login for the local UI.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password

# Service inter-communication URLs
CATALOG_SERVICE_URL=http://localhost:3002
IDENTITY_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3004
SALES_SERVICE_URL=http://localhost:3005

# Internal service secrets (HMAC signed identity context)
INTERNAL_IDENTITY_SECRET=replace_with_random_internal_identity_secret
INTERNAL_SERVICE_SECRET=replace_with_random_internal_service_secret
# Master key that seals the AI provider API keys admins store in a service's database (AES-256-GCM).
# It must be 32 random bytes encoded as base64. Generate one with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Database credentials and URLs
POSTGRES_USER=pharmacycentral
POSTGRES_PASSWORD=change_this_password
# One Postgres role per service; each owns only its own database. deploy/local/postgres/roles.sh creates them.
IDENTITY_DB_PASSWORD=change_this_identity_db_password
CATALOG_DB_PASSWORD=change_this_catalog_db_password
INVENTORY_DB_PASSWORD=change_this_inventory_db_password
SALES_DB_PASSWORD=change_this_sales_db_password
PAYMENT_DB_PASSWORD=change_this_payment_db_password
OPERATIONS_QUERY_DB_PASSWORD=change_this_operations_query_db_password
CHATBOT_DB_PASSWORD=change_this_chatbot_db_password
DATABASE_URL=postgres://catalog_service:change_this_catalog_db_password@localhost:5432/catalog_service

# Message broker & Cache
RABBITMQ_USER=pharmacycentral
RABBITMQ_PASSWORD=change_this_password
RABBITMQ_URL=amqp://pharmacycentral:change_this_password@localhost:5672/
REDIS_URL=redis://localhost:6379

# Local product image object storage
SEAWEEDFS_ACCESS_KEY=pharmacycentral
SEAWEEDFS_SECRET_KEY=replace_with_seaweedfs_secret_key
SEAWEEDFS_MEDIA_BUCKET=product-media
SEAWEEDFS_PUBLIC_MEDIA_URL=http://localhost:9000/product-media
SEAWEEDFS_ENDPOINT=http://localhost:9000

# Product search index (Typesense). catalog-service rebuilds it from Postgres; search-service only reads it.
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=replace_with_typesense_api_key

# Delivery fee calculation (OpenRouteService)
OPENROUTESERVICE_API_KEY=replace_with_openrouteservice_key
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
# Routes under the free distance cost nothing. From there the fee is the base plus the per-kilometer amount for
# every full kilometer beyond the free distance. Only routes shorter than the maximum distance are delivered.
DELIVERY_FREE_DISTANCE_METERS=2000
DELIVERY_FEE_BASE=5000
DELIVERY_FEE_PER_KILOMETER=2000
DELIVERY_MAX_DISTANCE_METERS=10000

# Address search and address labels (Vietmap). This key is metered, so it stays in the service and the browser
# reaches Vietmap through the sales service instead. Register free at https://maps.vietmap.vn/console-v2/register
VIETMAP_API_KEY=replace_with_vietmap_api_key
VIETMAP_BASE_URL=https://maps.vietmap.vn

# AI features for local development: the chatbot, prescription photo reading and embeddings for semantic product search.
# Each feature has four variables, AI_<FEATURE>_PROVIDER, _BASE_URL, _MODEL and _API_KEY. Set all four or none.
# The chat model (the chatbot) has two adapters, `gemini` and `openai-compatible`. `openai-compatible` speaks the chat
# completions API with tool calling, at POST {baseUrl}/chat/completions, so its base URL carries the version path. Photo
# reading and embeddings are Gemini only. `typesafe` (TypeSafe Jev) is the intent gate only, which screens each shopper
# question before the chatbot. Production leaves all of them unset, because a Platform Admin saves each feature's
# settings in staff-web and each service keeps them encrypted in its own database under SECRETS_ENCRYPTION_KEY. Saved
# settings win as a whole over these variables. With none set, the chatbot and photo reading answer 503 and product
# search is keyword only; QR intake works either way. With no intent gate settings the gate is off and every question
# goes to the chatbot.
# Get a Gemini key at https://aistudio.google.com/apikey
# For openai-compatible, set AI_CHATBOT_BASE_URL to the API base URL with its version path, for example
# https://llm.example.com/v1.
AI_CHATBOT_PROVIDER=gemini
AI_CHATBOT_BASE_URL=https://generativelanguage.googleapis.com
AI_CHATBOT_MODEL=gemini-3.5-flash
AI_CHATBOT_API_KEY=
AI_INTENT_GATE_PROVIDER=typesafe
AI_INTENT_GATE_BASE_URL=https://api.typesafe.ai
AI_INTENT_GATE_MODEL=jev-latest
AI_INTENT_GATE_API_KEY=
AI_PRESCRIPTION_READER_PROVIDER=gemini
AI_PRESCRIPTION_READER_BASE_URL=https://generativelanguage.googleapis.com
AI_PRESCRIPTION_READER_MODEL=gemini-3.5-flash
AI_PRESCRIPTION_READER_API_KEY=
# Product search embeddings come from the embedder service of Compose (infra:up and stack:up start it). Keep
# AI_EMBEDDING_MODEL and AI_EMBEDDING_API_KEY equal to EMBEDDER_MODEL and EMBEDDER_API_KEY below. The container
# stack ignores AI_EMBEDDING_BASE_URL and uses http://embedder:80/v1. To use Gemini instead, set provider gemini,
# base URL https://generativelanguage.googleapis.com, model gemini-embedding-001 and your key, and edit the
# catalog-service and search-service base URL in docker-compose.yml.
AI_EMBEDDING_PROVIDER=openai-compatible
AI_EMBEDDING_BASE_URL=http://localhost:8109/v1
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AI_EMBEDDING_API_KEY=replace_with_embedder_api_key
EMBEDDER_MODEL=intfloat/multilingual-e5-small
EMBEDDER_API_KEY=replace_with_embedder_api_key

# Tilemap key renders the map tiles and is therefore the one key that ships to the browser. It is separate from
# the services key above on purpose: Vietmap rejects one in place of the other with HTTP 423.
VITE_VIETMAP_TILEMAP_KEY=replace_with_vietmap_tilemap_key

# Payment & VietQR settings (SePay)
SEPAY_WEBHOOK_SECRET=replace_with_random_secret
PHARMACY_PAYMENT_SEPAY_BANK=MB
PHARMACY_PAYMENT_SEPAY_ACCOUNT_NUMBER=replace_with_test_account_number
PHARMACY_PAYMENT_SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# Google OIDC Authentication
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Email & Verification settings
EMAIL_PROVIDER=smtp
EMAIL_FROM=Pharmacy Central <no-reply@pharmacy.local>
PUBLIC_APP_URL=http://customer.pharmacy.localhost
SMTP_HOST=localhost
SMTP_PORT=1025

# Password hashing (Argon2id)
ARGON2_MEMORY_KIB=19456
ARGON2_PASSES=2
ARGON2_PARALLELISM=1

# Attempt limit on login, register, and password-reset routes (identity-service), counted in a sliding window kept in
# REDIS_URL per email (or account id on the token routes) and client address. Failed sign-ins count toward login; a
# successful sign-in gives its attempt back. The other routes count every attempt.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Reverse proxies in front of identity-service that append to X-Forwarded-For. The local gateway is one hop.
# AWS (API Gateway and the internal ALB) is not verified yet; see docs/runbook.md before changing it.
TRUST_PROXY_HOPS=1

# Local demo accounts (pnpm run dev:data)
DEMO_ACCOUNT_PASSWORD=replace_with_demo_account_password

