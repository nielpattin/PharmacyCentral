{
  "name": "pharmacy-central",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build --all",
    "dev": "nx run-many -t dev --all",
    "fmt": "oxfmt -c oxfmt.config.ts",
    "fmt:check": "oxfmt --check -c oxfmt.config.ts",
    "graph": "nx graph",
    "infra:down": "docker compose --profile dev down",
    "infra:up": "docker compose up -d postgres rabbitmq valkey mailpit otel-collector seaweedfs seaweedfs-init gateway-dev",
    "seed:accounts": "pnpm --dir apps/identity-service seed",
    "images:import": "pnpm --dir apps/catalog-service images:import",
    "images:pack": "tar -czf data/product-images/images.tar.gz -C data/product-images images",
    "images:unpack": "tar -xzf data/product-images/images.tar.gz -C data/product-images",
    "prescriptions:samples": "pnpm --dir apps/sales-service prescriptions:samples",
    "stack:down": "docker compose stop gateway identity-service catalog-service inventory-service sales-service payment-service operations-query-service customer-web staff-web && docker compose up -d --wait gateway-dev",
    "stack:up": "docker compose stop gateway-dev && docker compose up -d --build --wait",
    "sync:check": "nx sync:check",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "typecheck": "nx run-many -t typecheck --all",
    "db:migrate": "node --env-file=.env tools/migrate-all.mjs"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "nx": "23.1.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "catalog:",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.16.0 <25"
  }
}
