# Local-only API gateway for `pnpm dev`: the services run on the host, and this container shares the
# host network (see the gateway-dev comment in docker-compose.yml), so every upstream is the host's own
# loopback on that service's host port from .env. The nginx image renders ${...} at start: the ports
# below and the listen port come from the environment, while `set $identity ...` and every `$variable`
# in routes.conf stay untouched because those names are not environment variables.
# A service that is not running only fails its own routes with 502.
upstream identity_dev { server 127.0.0.1:${IDENTITY_PORT}; }
upstream catalog_dev { server 127.0.0.1:${CATALOG_PORT}; }
upstream search_dev { server 127.0.0.1:${SEARCH_PORT}; }
upstream inventory_dev { server 127.0.0.1:${INVENTORY_PORT}; }
upstream sales_dev { server 127.0.0.1:${SALES_PORT}; }
upstream chatbot_dev { server 127.0.0.1:${CHATBOT_PORT}; }
upstream ops_dev { server 127.0.0.1:${OPS_CONSOLE_PORT}; }
upstream payment_dev { server 127.0.0.1:${PAYMENT_PORT}; }
upstream query_dev { server 127.0.0.1:${OPERATIONS_QUERY_PORT}; }

map $request_method $products_upstream {
    GET $search;
    default $catalog;
}

server {
    listen 127.0.0.1:${GATEWAY_PORT};
    server_name localhost;

    set $identity http://identity_dev;
    set $catalog http://catalog_dev;
    set $search http://search_dev;
    set $inventory http://inventory_dev;
    set $sales http://sales_dev;
    set $payment http://payment_dev;
    set $query http://query_dev;
    set $chatbot http://chatbot_dev;
    set $ops http://ops_dev;

    # Any proxy_set_header here replaces nginx's defaults for every location below, so Host and Connection are restated.
    # X-Forwarded-For is overwritten with the address this gateway saw, so a client cannot supply its own.
    proxy_set_header Host $proxy_host;
    proxy_set_header Connection close;
    proxy_set_header X-Forwarded-For $remote_addr;

    # Client-supplied actor headers never reach a service. An empty value makes nginx omit the header. Services take
    # identity only from the Authorization bearer token, so that header is left alone and reaches them untouched.
    proxy_set_header X-Actor-Id "";
    proxy_set_header X-Actor-Type "";
    proxy_set_header X-Actor-Site-Ids "";

    include /etc/nginx/pharmacy-routes.conf;
}
