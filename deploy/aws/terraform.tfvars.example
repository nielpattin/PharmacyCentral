aws_region   = "ap-southeast-1"
project_name = "pharmacy-central"
environment  = "staging"

# Set services_enabled to false for initial bootstrap so database migrations can run before long-running services start.
services_enabled = false

# Supply networking IDs from the AWS account. Keep these values outside Git.
vpc_id                 = "vpc-00000000000000000"
private_subnet_ids     = ["subnet-00000000000000000", "subnet-11111111111111111"]
api_gateway_subnet_ids = ["subnet-00000000000000000", "subnet-11111111111111111"]

allowed_origins = ["https://staff.example.com", "https://www.example.com"]

# Optional private repository credentials Secret ARN for pulling container images from GHCR.
repository_credentials_secret_arn = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/ghcr-credentials"

# Use the immutable digest emitted by the image build pipeline.
images = {
  identity-service = "ghcr.io/example/pharmacy-central/identity-service@sha256:replace-me"
  catalog-service = "ghcr.io/example/pharmacy-central/catalog-service@sha256:replace-me"
  inventory-service = "ghcr.io/example/pharmacy-central/inventory-service@sha256:replace-me"
  sales-service = "ghcr.io/example/pharmacy-central/sales-service@sha256:replace-me"
  payment-service = "ghcr.io/example/pharmacy-central/payment-service@sha256:replace-me"
  operations-query-service = "ghcr.io/example/pharmacy-central/operations-query-service@sha256:replace-me"
  chatbot-service = "ghcr.io/example/pharmacy-central/chatbot-service@sha256:replace-me"
  search-service = "ghcr.io/example/pharmacy-central/search-service@sha256:replace-me"
}

# The self-hosted product search embedder (deploy/embedder). Build the image with its model baked in, push it, and pin
# the digest. The service is internal: catalog-service reaches it at http://embedder.<environment>.pharmacy.internal:80/v1.
embedder_image = "ghcr.io/example/pharmacy-central/embedder@sha256:replace-me"

# Secrets Manager ARN of the embedder API key. The embedder reads it as API_KEY, and catalog-service and search-service
# read the same secret as AI_EMBEDDING_API_KEY.
embedder_api_key_secret_arn = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/embedder-api-key"

# Optional. 2 vCPU and 4 GiB handle about 200 new queries a second, and 4 vCPU added little in the same test.
# embedder_task_cpu         = 2048
# embedder_task_memory      = 4096

# Optional. sales-service takes every order and runs its outbox relay, so it gets more than task_cpu / task_memory.
# 1024 CPU takes 2048 to 8192 MiB.
# sales_task_cpu    = 1024
# sales_task_memory = 2048

# Non-secret environment variables. Service URLs should use Cloud Map names, for example:
# http://catalog-service.staging.pharmacy.internal:3002
service_environment = {
  chatbot-service = {
    CATALOG_SERVICE_URL = "http://catalog-service.staging.pharmacy.internal:3002"
  }
  catalog-service = {}
  inventory-service = {
    CATALOG_SERVICE_URL = "http://catalog-service.staging.pharmacy.internal:3002"
  }
  sales-service = {
    CATALOG_SERVICE_URL   = "http://catalog-service.staging.pharmacy.internal:3002"
    IDENTITY_SERVICE_URL  = "http://identity-service.staging.pharmacy.internal:3001"
    INVENTORY_SERVICE_URL = "http://inventory-service.staging.pharmacy.internal:3004"
  }
  payment-service = {
    CATALOG_SERVICE_URL = "http://catalog-service.staging.pharmacy.internal:3002"
    SALES_SERVICE_URL   = "http://sales-service.staging.pharmacy.internal:3005"
  }
  operations-query-service = {
    CATALOG_SERVICE_URL   = "http://catalog-service.staging.pharmacy.internal:3002"
    INVENTORY_SERVICE_URL = "http://inventory-service.staging.pharmacy.internal:3004"
    SALES_SERVICE_URL     = "http://sales-service.staging.pharmacy.internal:3005"
  }
  search-service = {
    CATALOG_SERVICE_URL        = "http://catalog-service.staging.pharmacy.internal:3002"
    OTEL_EXPORTER_OTLP_ENDPOINT = "http://otel-collector.staging.pharmacy.internal:4318"
  }
}

# Secret values belong in Secrets Manager. These maps contain ARNs only.
shared_secrets = {
  INTERNAL_IDENTITY_SECRET = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/internal-identity"
  INTERNAL_SERVICE_SECRET  = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/internal-service"
  RABBITMQ_URL             = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/rabbitmq-url"
  REDIS_URL                = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/redis-url"
}

service_secrets = {
  chatbot-service = {
    DATABASE_URL           = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/chatbot-db"
    SECRETS_ENCRYPTION_KEY = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/secrets-encryption-key"
  }
  identity-service = {
    DATABASE_URL = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/identity-db"
  }
  catalog-service = {
    DATABASE_URL           = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/catalog-db"
    SECRETS_ENCRYPTION_KEY = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/secrets-encryption-key"
    TYPESENSE_API_KEY      = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/typesense-api-key"
    TYPESENSE_URL          = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/typesense-url"
  }
  inventory-service = {
    DATABASE_URL = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/inventory-db"
  }
  sales-service = {
    DATABASE_URL           = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/sales-db"
    SECRETS_ENCRYPTION_KEY = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/secrets-encryption-key"
  }
  payment-service = {
    DATABASE_URL         = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/payment-db"
    SEPAY_WEBHOOK_SECRET = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/sepay-webhook"
  }
  operations-query-service = {
    DATABASE_URL = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/operations-query-db"
  }
  search-service = {
    TYPESENSE_API_KEY = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/typesense-api-key"
    TYPESENSE_URL     = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/typesense-url"
  }
}

authorizer_secrets = {
  INTERNAL_IDENTITY_SECRET = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/internal-identity"
  INTERNAL_SERVICE_SECRET  = "arn:aws:secretsmanager:ap-southeast-1:000000000000:secret:pharmacy-central/staging/internal-service"
}
