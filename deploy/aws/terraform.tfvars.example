# Copy to terraform.tfvars or pass with -var. Everything else comes from demo.auto.tfvars.json, which tools/aws-env.mjs
# writes from the root .env (service settings and secrets, git-ignored); it overrides terraform.tfvars.

# The web apps are served at shop.<domain_name> (customer) and staff.<domain_name> (staff). Terraform creates their DNS
# records in the Cloudflare zone below; export CLOUDFLARE_API_TOKEN (DNS Write on that zone) before plan and apply.
domain_name        = "example.com"
cloudflare_zone_id = "replace-with-zone-id"

# Tag of the images pushed by tools/aws-push-images.mjs <tag>. tools/aws-env.mjs writes it too when given.
image_tag = "replace-with-image-tag"

# First apply: false, so the database roles and migrations run before the services start.
services_enabled = false

# Task sizes (`task_cpu`/`task_memory` 512/2048 for backend, migration and ops; `web_task_cpu`/`web_task_memory` 256/512)
# and the 1-task counts (`desired_count`, optional per-service `service_desired_count`) are the defaults in variables.tf,
# sized to the 6 vCPU Fargate quota. Off by default: services run the fixed counts. To turn on ECS Application Auto Scaling
# (`autoscaling.tf`, target tracking on average CPU and memory between `autoscale_min_capacity` and
# `autoscale_max_capacity` tasks), set this to true.
autoscaling_enabled             = false
autoscale_min_capacity          = 1
autoscale_max_capacity          = 3
autoscale_cpu_target_percent    = 50
autoscale_memory_target_percent = 70

# Off for the demo. Setting them to true starts the OpenTelemetry collector and the embedder.
otel_collector_enabled = false
embedder_enabled       = false
