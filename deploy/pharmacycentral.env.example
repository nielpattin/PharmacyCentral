# Reference values for an AWS application deployment. Do not use this file for local Compose.
# Do not commit real production secrets.

POSTGRES_DB=pharmacycentral
POSTGRES_USER=pharmacycentral
POSTGRES_PASSWORD=replace_with_a_strong_database_password
IDENTITY_DB_PASSWORD=replace_with_a_strong_identity_database_password
CATALOG_DB_PASSWORD=replace_with_a_strong_catalog_database_password
INVENTORY_DB_PASSWORD=replace_with_a_strong_inventory_database_password
SALES_DB_PASSWORD=replace_with_a_strong_sales_database_password
PAYMENT_DB_PASSWORD=replace_with_a_strong_payment_database_password
OPERATIONS_QUERY_DB_PASSWORD=replace_with_a_strong_operations_query_database_password
CHATBOT_DB_PASSWORD=replace_with_a_strong_chatbot_database_password
POSTGRES_PORT=5432

API_BASE_URL=https://<api-gateway-id>.execute-api.<region>.amazonaws.com
NODE_ENV=production

# Local Compose uses .env.example and its local Nginx gateway.
# An AWS web deployment must proxy /api requests to the managed API Gateway endpoint above.
