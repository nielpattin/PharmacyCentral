# Copy this file to a local, untracked .env file before running docker compose.
# Do not commit real production secrets.

POSTGRES_DB=pharmacycentral
POSTGRES_USER=pharmacycentral
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=5432

APP_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# The compose file builds a single app container that serves both the API and built web UI.
# In a real environment, place the app behind a TLS-terminating reverse proxy/load balancer.
