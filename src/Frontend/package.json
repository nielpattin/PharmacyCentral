{
   "name": "frontend",
   "version": "0.0.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "vite",
      "preview": "vite preview",
      "build": "tsc -b && vite build",
      "lint": "oxlint -c oxlint.config.ts",
      "lint:fix": "oxlint --fix",
      "fmt": "oxfmt -c oxfmt.config.ts",
      "fmt:check": "oxfmt --check",
      "prepare": "husky"
   },
   "dependencies": {
      "lucide-react": "^1.14.0",
      "motion": "^12.40.0",
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "recharts": "^3.8.1"
   },
   "devDependencies": {
      "@types/node": "^24.10.1",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.0",
      "globals": "^16.5.0",
      "husky": "^9.1.7",
      "lint-staged": "^16.4.0",
      "oxfmt": "^0.47.0",
      "oxlint": "^1.62.0",
      "oxlint-tsgolint": "^0.22.1",
      "typescript": "^6.0.3",
      "vite": "^8.0.0"
   },
   "lint-staged": {
      "*.{js,jsx,ts,tsx,mjs,cjs}": [
         "oxfmt --no-error-on-unmatched-pattern",
         "pnpm run lint"
      ]
   },
   "engines": {
      "node": "^22 || >=24"
   }
}
